            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="ItemId_BeanShellPostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
import java.util.Random;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;itemId=(.*?)\&quot;&quot;);
Matcher matcher = pattern.matcher(response);

int count = 0;

while (matcher.find()) {
    count++;
    vars.put(&quot;itemId_&quot; + count, matcher.group(1));
}

vars.put(&quot;itemId_matchNr&quot;, String.valueOf(count));

if (count &gt; 0) {
    Random rand = new Random();
    int randomIndex = rand.nextInt(count) + 1;

    String itemId = vars.get(&quot;itemId_&quot; + randomIndex);
    vars.put(&quot;randomItemId&quot;, itemId);

    log.info(&quot;Selected Item ID: &quot; + itemId);
} else {
    log.info(&quot;No Item ID found.&quot;);
}</stringProp>
            </BeanShellPostProcessor>
