            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="ProductId_BeanShellPostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
import java.util.Random;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;productId=(.*?)\&quot;&quot;);
Matcher matcher = pattern.matcher(response);

int count = 0;

while (matcher.find()) {
    count++;
    vars.put(&quot;productId_&quot; + count, matcher.group(1));
}

vars.put(&quot;productId_matchNr&quot;, String.valueOf(count));

if (count &gt; 0) {
    Random rand = new Random();
    int randomIndex = rand.nextInt(count) + 1;

    String product = vars.get(&quot;productId_&quot; + randomIndex);
    vars.put(&quot;randomProductId&quot;, product);

    log.info(&quot;Selected Product: &quot; + product);
} else {
    log.info(&quot;No Product ID found.&quot;);
}</stringProp>
            </BeanShellPostProcessor>
