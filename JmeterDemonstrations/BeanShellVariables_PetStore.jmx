            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="CategoryId_BeanShellPostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
import java.util.Random;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;categoryId=(.*?)\&quot;&gt;&quot;);
Matcher matcher = pattern.matcher(response);

int count = 0;

// Store all extracted categories
while (matcher.find()) {
    count++;
    vars.put(&quot;categoryId_&quot; + count, matcher.group(1));
}

vars.put(&quot;categoryId_matchNr&quot;, String.valueOf(count));

if (count &gt; 0) {
    Random rand = new Random();
    int randomIndex = rand.nextInt(count) + 1;

    String randomCategory = vars.get(&quot;categoryId_&quot; + randomIndex);
    vars.put(&quot;randomCategory&quot;, randomCategory);

    log.info(&quot;Random Category: &quot; + randomCategory);
} else {
    log.info(&quot;No category found.&quot;);
}</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="JSession_BeanShell PostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;jsessionid=([A-Z0-9]+)&quot;);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {
    vars.put(&quot;jsessionid&quot;, matcher.group(1));
    log.info(&quot;JSESSIONID = &quot; + matcher.group(1));
} else {
    vars.put(&quot;jsessionid&quot;, &quot;NOT_FOUND&quot;);
}</stringProp>
            </BeanShellPostProcessor>
