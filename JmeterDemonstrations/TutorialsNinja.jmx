              </BeanShellPreProcessor>
              <hashTree/>
              <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="SucessMessage_Extractor" enabled="true">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">String response = prev.getResponseDataAsString();

int retry = Integer.parseInt(vars.get(&quot;retryCount&quot;));

if (response.contains(&quot;Success: You have added&quot;)) {

    vars.put(&quot;cartSuccess&quot;, &quot;true&quot;);

    log.info(&quot;Add To Cart Successful&quot;);

} else {

    retry++;

    vars.put(&quot;retryCount&quot;, String.valueOf(retry));

    vars.put(&quot;cartSuccess&quot;, &quot;false&quot;);

    log.warn(&quot;Retry Attempt : &quot; + retry);
}</stringProp>
              </BeanShellPostProcessor>
