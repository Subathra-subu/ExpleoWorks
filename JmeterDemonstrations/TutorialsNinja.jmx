            <hashTree/>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="SearchItem_PreProcessor" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">String kw = vars.get(&quot;keyword&quot;);
String firstChar = kw.substring(0, 1);
String rest = kw.substring(1);
String searchTerm = firstChar.toUpperCase() + rest;

log.info(&quot;Search Item = &quot; + searchTerm);

vars.put(&quot;searchTerm&quot;, searchTerm);</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="ProductID_Extractor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;product_id=([0-9]+)&quot;);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {

    String productId = matcher.group(1);

    vars.put(&quot;productId&quot;, productId);
    props.put(&quot;ProductID&quot;, productId);

    log.info(&quot;Product ID Extracted = &quot; + productId);

} else {

    log.error(&quot;Product ID NOT FOUND&quot;);

}</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion" enabled="true">
              <stringProp name="BeanShellAssertion.query">String productId = vars.get(&quot;productId&quot;);
if (&quot;0&quot;.equals(productId)) {
 Failure = true;
 FailureMessage = &quot;Product ID not found in response&quot;;
}

String response = prev.getResponseDataAsString();
if (!response.contains(&quot;product-thumb&quot;)) {
 Failure = true;
 FailureMessage = &quot;Search results page missing product thumbnails&quot;;
}
</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
            <hashTree/>
          </hashTree>
