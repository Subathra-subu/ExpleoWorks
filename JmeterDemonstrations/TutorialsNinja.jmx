                <stringProp name="filename"></stringProp>
                <stringProp name="script">if (vars.get(&quot;retryCount&quot;) == null) {
    vars.put(&quot;retryCount&quot;, &quot;0&quot;);
}

if (vars.get(&quot;cartSuccess&quot;) == null) {
