            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Encryption_PreProcessor">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.SecretKeySpec
import java.util.Base64

def username = &quot;admin&quot;
def password = &quot;admin&quot;

def secretKey = &quot;1234567890123456&quot;

def key = new SecretKeySpec(secretKey.getBytes(&quot;UTF-8&quot;),&quot;AES&quot;)
def cipher = Cipher.getInstance(&quot;AES&quot;)

cipher.init(Cipher.ENCRYPT_MODE,key)

byte[] encryptedBytes = cipher.doFinal(password.getBytes(&quot;UTF-8&quot;))
String encryptedPassword = Base64.encoder.encodeToString(encryptedBytes) 

vars.put(&quot;username&quot;,username)
vars.put(&quot;encryptedpassword&quot;,encryptedPassword)

log.info(&quot;==============================&quot;)
log.info(&quot;Username:&quot;+username)
log.info(&quot;Original Password:&quot;+password)
log.info(&quot;Encrypted Password:&quot;+encryptedPassword)
log.info(&quot;===============================&quot;)


</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Decryption_PreProcessor">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.SecretKeySpec
import java.util.Base64

def secretKey = &quot;1234567890123456&quot;

def encryptedPassword = vars.get(&quot;encryptedpassword&quot;)

def key = new SecretKeySpec(secretKey.getBytes(&quot;UTF-8&quot;), &quot;AES&quot;)
def cipher = Cipher.getInstance(&quot;AES&quot;)

cipher.init(Cipher.DECRYPT_MODE, key)

byte[] decryptedBytes = cipher.doFinal(Base64.decoder.decode(encryptedPassword))
String decryptedPassword = new String(decryptedBytes, &quot;UTF-8&quot;)

vars.put(&quot;decryptedpassword&quot;, decryptedPassword)

log.info(&quot;==============================&quot;)
log.info(&quot;Encrypted Password: &quot; + encryptedPassword)
log.info(&quot;Decrypted Password: &quot; + decryptedPassword)
log.info(&quot;==============================&quot;)</stringProp>
            </JSR223PreProcessor>
