            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.*;
String response = prev.getResponseDataAsString();
Pattern pattern = Pattern.compile(&quot;&amp;quot;firstName&amp;quot;:&amp;quot;(.*?)&amp;quot;,&amp;quot;&quot;);
Matcher matcher = pattern.matcher(response);

if(matcher.find()){
	String firstName = matcher.group(1);
	vars.put(&quot;firstName&quot;,firstName);
	log.info(&quot;Extracted FirstName:&quot;+firstName);
}</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion">
              <stringProp name="BeanShellAssertion.query">String firstName = vars.get(&quot;firstName&quot;);

if (!firstName.equals(&quot;Sham&quot;)) {
    Failure = true;
    FailureMessage = &quot;Invalid username&quot;;
}
else{
	log.info(&quot;Valid user&quot;);
}
</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
